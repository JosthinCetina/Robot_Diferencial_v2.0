<?xml version="1.0"?>
<package format="3">
  <name>dif_bot_web_bridge</name><version>2.0.0</version>
  <description>ROS topics/actions exposed to dif_bot OS web frontend.</description>
  <maintainer email="maintainer@example.com">dif_bot maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend><exec_depend>std_srvs</exec_depend><exec_depend>std_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
