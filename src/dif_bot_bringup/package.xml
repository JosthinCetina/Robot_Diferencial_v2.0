<?xml version="1.0"?>
<package format="3">
  <name>dif_bot_bringup</name><version>2.0.0</version>
  <description>Single entry point for dif_bot OS on ROS 2 Jazzy.</description>
  <maintainer email="maintainer@example.com">dif_bot maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>dif_bot_gazebo</exec_depend>
  <exec_depend>dif_bot_control</exec_depend><exec_depend>dif_bot_web_bridge</exec_depend>
  <exec_depend>dif_bot_navigation</exec_depend><exec_depend>twist_mux</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
