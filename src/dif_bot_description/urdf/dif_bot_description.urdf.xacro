<?xml version="1.0"?>
<robot name="dif_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="use_ros2_control" default="true"/>

    <!-- ======================================================== -->
    <!-- 1. Inclusión de Archivos Secundarios                     -->
    <!-- ======================================================== -->
    <xacro:include filename="inertial_macros.xacro"/>
    <xacro:include filename="sensors.xacro"/>

    <!-- ======================================================== -->
    <!-- 2. Propiedades Xacro (Dimensiones, Offsets y Radios)     -->
    <!-- ======================================================== -->
    <xacro:property name="base_length" value="0.30"/>
    <xacro:property name="base_width" value="0.25"/>
    <xacro:property name="base_height" value="0.10"/>
    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_length" value="0.04"/>
    <xacro:property name="wheel_offset_x" value="0.05"/>
    <xacro:property name="wheel_offset_y" value="0.15"/>
    <xacro:property name="wheel_offset_z" value="0.0"/>
    <xacro:property name="caster_radius" value="0.025"/>
    <xacro:property name="caster_offset_x" value="-0.10"/>
    <xacro:property name="caster_offset_z" value="-0.025"/>

    <!-- Materiales de Visualización -->
    <material name="blue">
        <color rgba="0.1 0.2 0.8 1.0"/>
    </material>
    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
    </material>

    <!-- ======================================================== -->
    <!-- 3. Link: base_footprint (Proyección sobre el suelo)     -->
    <!-- ======================================================== -->
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- ======================================================== -->
    <!-- 4. Link: base_link (Chasis del Robot)                    -->
    <!-- ======================================================== -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        <!-- Inercia del chasis (Masa: 1.0 kg) -->
        <xacro:inertial_box mass="1.0" x="${base_length}" y="${base_width}" z="${base_height}">
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

<!-- ======================================================== -->
    <!-- 5. Macro para la creación de Ruedas de Tracción          -->
    <!-- ======================================================== -->
    <xacro:macro name="wheel" params="prefix side_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
            </collision>
            <!-- Inercia de la rueda (Masa: 0.1 kg) -->
            <xacro:inertial_cylinder mass="0.1" length="${wheel_length}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${wheel_offset_x} ${side_reflect * wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <!-- Propiedades de contacto/fricción en Gazebo para la rueda -->
        <gazebo reference="${prefix}_wheel">
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

    <!-- Instanciación de Ruedas usando la Macro -->
    <xacro:wheel prefix="left" side_reflect="1"/>
    <xacro:wheel prefix="right" side_reflect="-1"/>

    <!-- ======================================================== -->
    <!-- 6. Link y Joint: Caster Wheel (Rueda Loca)              -->
    <!-- ======================================================== -->
    <link name="caster_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
        <!-- Inercia de la rueda loca (Masa: 0.05 kg) -->
        <xacro:inertial_sphere mass="0.05" radius="${caster_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="${caster_offset_x} 0 ${caster_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- Reducción de fricción en la rueda loca para permitir el giro suave -->
    <gazebo reference="caster_wheel">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>

    <!-- ======================================================== -->
    <!-- 7. Control diferencial: ROS 2 Control o Gazebo nativo    -->
    <!-- ======================================================== -->
    <xacro:if value="$(arg use_ros2_control)">
      <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="left_wheel_joint">
          <command_interface name="velocity">
            <param name="min">-20.0</param>
            <param name="max">20.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="right_wheel_joint">
          <command_interface name="velocity">
            <param name="min">-20.0</param>
            <param name="max">20.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
      <gazebo>
        <plugin filename="libgz_ros2_control-system.so"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find dif_bot_description)/config/controllers.yaml</parameters>
          <controller_manager_prefix_node_name>controller_manager</controller_manager_prefix_node_name>
        </plugin>
      </gazebo>
    </xacro:if>

    <xacro:unless value="$(arg use_ros2_control)">
      <gazebo>
        <plugin filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
          <left_joint>left_wheel_joint</left_joint>
          <right_joint>right_wheel_joint</right_joint>
          <wheel_separation>0.30</wheel_separation>
          <wheel_radius>0.05</wheel_radius>
          <topic>/cmd_vel</topic>
          <odom_topic>/odom_raw</odom_topic>
          <tf_topic>/model/dif_bot/tf</tf_topic>
          <frame_id>odom</frame_id>
          <child_frame_id>base_footprint</child_frame_id>
          <odom_publish_frequency>30</odom_publish_frequency>
        </plugin>
      </gazebo>
    </xacro:unless>

</robot>
